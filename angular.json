{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "osumi-angular-tools": {
      "schematics": {
        "tsConfig": "tsconfig.schematics.json"
      },
      "projectType": "library",
      "root": "projects/osumi-angular-tools",
      "sourceRoot": "projects/osumi-angular-tools",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:library",
          "options": {
            "tsConfig": "projects/osumi-angular-tools/tsconfig.lib.json",
            "outputPath": "dist/osumi-angular-tools",
            "assets": [
              "projects/osumi-angular-tools/styles",
              {
                "glob": "**/*",
                "input": "projects/osumi-angular-tools/schematics",
                "output": "/schematics"
              }
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "projects/osumi-angular-tools/styles"
              ]
            },
            "allowedNonPeerDependencies": [
              "@angular-devkit/schematics"
            ]
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/osumi-angular-tools/tsconfig.lib.prod.json"
            },
            "development": {
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "projects/osumi-angular-tools/tsconfig.spec.json",
            "polyfills": ["zone.js", "zone.js/testing"]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/osumi-angular-tools/**/*.ts",
              "projects/osumi-angular-tools/**/*.html"
            ],
            "eslintConfig": "projects/osumi-angular-tools/eslint.config.js"
          }
        }
      }
    }
  },
  "cli": {
    "schematicCollections": ["angular-eslint"]
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
